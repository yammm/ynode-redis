{
    "name": "@ynode/redis",
    "version": "1.7.1+355874",
    "description": "Fastify 5 plugin for Redis (node-redis) with automatic connection lifecycle, health checks, and namespace support.",
    "main": "src/plugin.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./src/plugin.js",
            "default": "./src/plugin.js"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "license": "MIT",
    "author": "Michael Welter <me@mikinho.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yammm/ynode-redis.git"
    },
    "bugs": {
        "url": "https://github.com/yammm/ynode-redis/issues"
    },
    "homepage": "https://github.com/yammm/ynode-redis#readme",
    "keywords": [
        "fastify",
        "fastify-plugin",
        "redis",
        "node-redis",
        "plugin",
        "cache",
        "connection",
        "health-check",
        "namespace"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.0",
        "@eslint/markdown": "^8.0.3",
        "@mikinho/autover": "^3.1.1",
        "@types/node": "^26.4.1",
        "auto-changelog": "^2.6.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "fastify": "^5.12.3",
        "globals": "^17.12.0",
        "jsdoc": "^4.0.5",
        "prettier": "^3.9.6",
        "redis": "^6.2.1",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "benchmark": "./scripts/benchmark.js",
        "changelog": "auto-changelog -p --commit-limit false",
        "docs": "node scripts/gen-docs.mjs",
        "docs:clean": "rimraf docs || rmdir /s /q docs 2> NUL || true",
        "docs:open": "node -e \"import('node:child_process').then(m=>m.exec(process.platform==='win32'?'start docs/index.html':(process.platform==='darwin'?'open docs/index.html':'xdg-open docs/index.html')))\"",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:staged": "node scripts/check-staged.mjs --lint-only",
        "lint:fix": "eslint . --fix",
        "test:unit": "node --test tests/health-unit.test.js tests/managed-unit.test.js tests/namespace-unit.test.js",
        "test:integration": "node --test tests/plugin-integration.test.js",
        "ver:preview": "npx --no-install autover --no-amend --dry-run --short",
        "ver:apply": "npx --no-install autover --guard-unchanged --short",
        "test": "node --test",
        "test:types": "tsc --project type-tests/tsconfig.json",
        "prepublishOnly": "npm run format:check && npm run lint && npm test && npm run test:types && npm run docs",
        "test:hooks": "node --test tests/check-staged.test.js tests/release.test.js",
        "release:check": "node scripts/verify-release.mjs",
        "release:patch": "node scripts/prepare-release.mjs patch",
        "release:minor": "node scripts/prepare-release.mjs minor",
        "release:major": "node scripts/prepare-release.mjs major"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "src",
        "index.d.ts",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "dependencies": {
        "fastify-plugin": "^6.0.0"
    },
    "peerDependencies": {
        "fastify": "5.x",
        "redis": "^6.0.0"
    },
    "packageManager": "npm@11.17.0"
}
